{
  "_comment": "Thresholds, weights and tier values of the shortlisting scorer (src/shortlisting/scorer.py). Set before looking at any held-out data; never tuned on validation, final or fresh resumes.",
  "weights": {
    "default":      {"education": 25, "experience": 20, "publications": 25, "topic_fit": 30},
    "education":    {"education": 50, "experience": 10, "publications": 15, "topic_fit": 25},
    "publications": {"education": 15, "experience": 10, "publications": 45, "topic_fit": 30},
    "experience":   {"education": 15, "experience": 40, "publications": 15, "topic_fit": 30}
  },
  "key_components": {
    "_comment": "A key component that is unusable sends the candidate to Review.",
    "default": ["education", "publications"],
    "education": ["education"],
    "publications": ["publications"],
    "experience": ["experience"]
  },
  "degree_levels": ["bachelors", "masters", "doctorate"],
  "degree_level_values": {"doctorate": 1.0, "masters": 0.7, "bachelors": 0.4},
  "degree_below_minimum_values": [1.0, 0.5, 0.2],
  "education_parts": {"degree_level": 0.4, "institution_tier": 0.4, "stream_fit": 0.2},
  "institution_tier_values": {"Tier 1": 1.0, "Tier 2": 0.7, "Tier 3": 0.4},
  "institution_tier_order": ["Tier 1", "Tier 2", "Tier 3"],
  "experience_status_values": {"meets": 1.0, "likely_meets": 0.7, "does_not_meet": 0.1},
  "venue_tier_values": {"A": 1.0, "B": 0.6, "C": 0.3, "unknown": 0.4},
  "venue_tier_order": ["A", "B", "C"],
  "publications": {
    "_comment": "Capped and weighted: presence, venue tier and recency matter, exact counts do not (the parser over-detects entries). Each entry adds venue value x recency weight; the sum is divided by cap and capped at 1.",
    "types": ["journal", "conference"],
    "cap": 6.0,
    "recency_half_life_years": 6,
    "unknown_year_weight": 0.5,
    "certainty_high_share": 0.6,
    "certainty_medium_share": 0.3
  },
  "bm25": {"k1": 1.5, "b": 0.75},
  "job_ad_keywords": {"top_k": 12, "ngram_max": 2},
  "certainty_values": {"high": 1.0, "medium": 0.6, "low": 0.3},
  "overall_certainty": {"high": {"min_share": 0.9, "min_mean": 0.85}, "medium": {"min_share": 0.6, "min_mean": 0.5}},
  "shortlist_threshold": 0.6,
  "parse_decision_forces_review_comment": "false: a NEEDS_REVIEW parse is shown on the card as a parser flag only and does not by itself send the candidate to Review (FAIL parses stay Unreadable); true: a NEEDS_REVIEW parse always means Review.",
  "parse_decision_forces_review": false,
  "stability": {"runs": 50, "seed": 13, "drop_rate": 0.10, "flip_rate": 0.05}
}
