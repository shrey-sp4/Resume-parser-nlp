{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume.schema.json",
  "title": "Resume main output (GT v2 format, docs/design.md section 5.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resume_file",
    "candidate_name",
    "education",
    "experience",
    "publications",
    "stated_totals",
    "notes"
  ],
  "properties": {
    "resume_file": {"type": "string"},
    "candidate_name": {"type": "string"},
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["degree", "degree_level", "stream", "institution"],
        "properties": {
          "degree": {"type": "string"},
          "degree_level": {"enum": ["doctorate", "masters", "bachelors", "other"]},
          "stream": {"type": "string"},
          "institution": {"type": "string"}
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_title", "institution", "dates", "experience_type"],
        "properties": {
          "job_title": {"type": "string"},
          "institution": {"type": "string"},
          "dates": {"type": "string"},
          "experience_type": {"enum": ["academic", "industry", "other"]}
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "type", "year", "venue"],
        "properties": {
          "title": {"type": "string"},
          "type": {"enum": ["journal", "conference", "other"]},
          "year": {"type": "string"},
          "venue": {"type": "string"}
        }
      }
    },
    "stated_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal", "conference", "total"],
      "properties": {
        "journal": {"type": ["integer", "null"], "minimum": 0},
        "conference": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "notes": {"type": "string"}
  }
}
